{
  "functions": [{ "source": "functions", "codebase": "nativ", "runtime": "nodejs22" }],
  "firestore": [{ "database": "nativ", "rules": "firestore.rules", "indexes": "firestore.indexes.json" }],
  "hosting": {
    "target": "nativ",
    "public": "dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [{ "source": "**", "destination": "/index.html" }]
  },
  "emulators": {
    "auth": { "port": 9099 },
    "functions": { "port": 5001 },
    "firestore": { "port": 8080 },
    "hosting": { "port": 5000 },
    "ui": { "enabled": true, "port": 4000 },
    "singleProjectMode": true
  }
}
